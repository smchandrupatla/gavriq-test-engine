{
  "name": "gavriq-test-engine",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:consolidated": "node scripts/consolidated-entrypoint.mjs",
    "start:worker": "tsx apps/worker/src/worker.ts",
    "start:scheduler": "tsx apps/api/src/scheduler.ts",
    "migrate": "tsx apps/api/src/db/migrate.ts",
    "seed": "tsx apps/api/src/seed-realistic-catalog.ts",
    "seed:catalog": "tsx apps/api/src/seed-realistic-catalog.ts",
    "seed:uploads": "tsx scripts/register-upload-tests.ts",
    "import:sit": "tsx apps/api/src/import-sit-catalog.ts",
    "mint-token": "tsx apps/api/src/scripts/mint-token.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/e2e-api-flow.test.ts",
    "test:unit": "tsx --test tests/enterprise-api-smoke.test.ts tests/classify.test.ts",
    "docs:catalog": "node scripts/generate-test-case-docs.mjs",
    "audit:atomicity": "tsx scripts/audit-case-atomicity.mts",
    "parse:junit": "node scripts/parse-junit.mjs",
    "report:build": "bash scripts/post-build-results.sh",
    "report:unit-container": "node scripts/in-container-unit-report.mjs",
    "sit": "node sit/run.mjs",
    "sit:console": "PORT=8098 node sit/console.mjs",
    "typecheck": "tsc --noEmit",
    "start:infra-agent": "tsx apps/infra-agent/src/agent.ts",
    "test:e2e-gui": "node scripts/run-category.mjs smoke && node scripts/run-category.mjs forms && node scripts/run-category.mjs nav && node scripts/run-category.mjs auth && node scripts/run-category.mjs responsive && node scripts/run-category.mjs accessibility && node scripts/run-category.mjs performance && node scripts/run-category.mjs state && node scripts/run-category.mjs localization && node scripts/run-category.mjs visual",
    "test:e2e-gui:smoke": "node scripts/run-category.mjs smoke",
    "test:e2e-gui:forms": "node scripts/run-category.mjs forms",
    "test:e2e-gui:nav": "node scripts/run-category.mjs nav",
    "test:e2e-gui:auth": "node scripts/run-category.mjs auth",
    "test:e2e-gui:visual": "node scripts/run-category.mjs visual",
    "test:e2e-gui:responsive": "node scripts/run-category.mjs responsive",
    "test:e2e-gui:accessibility": "node scripts/run-category.mjs accessibility",
    "test:e2e-gui:performance": "node scripts/run-category.mjs performance",
    "test:e2e-gui:resilience": "node scripts/run-category.mjs resilience",
    "test:e2e-gui:localization": "node scripts/run-category.mjs localization",
    "test:e2e-gui:state": "node scripts/run-category.mjs state"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@e2e-dev/web": "^0.14.0",
    "ai": "^7.0.137",
    "e2e": "^0.19.0",
    "fastify": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "jose": "^6.0.10",
    "pg": "^8.16.0",
    "playwright": "1.63.0",
    "selenium-webdriver": "^4.48.0",
    "tsx": "^4.20.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.2"
  },
  "license": "UNLICENSED"
}
