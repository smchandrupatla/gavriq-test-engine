{
  "name": "gavriq-test-engine",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:consolidated": "node scripts/consolidated-entrypoint.mjs",
    "start:worker": "tsx apps/worker/src/worker.ts",
    "start:scheduler": "tsx apps/api/src/scheduler.ts",
    "migrate": "tsx apps/api/src/db/migrate.ts",
    "seed": "tsx apps/api/src/seed.ts",
    "seed:sandbench": "tsx apps/api/src/seed-sandbench-catalog.ts",
    "import:sit": "tsx apps/api/src/import-sit-catalog.ts",
    "mint-token": "tsx apps/api/src/scripts/mint-token.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/e2e-api-flow.test.ts",
    "test:unit": "tsx --test tests/enterprise-api-smoke.test.ts tests/classify.test.ts",
    "parse:junit": "node scripts/parse-junit.mjs",
    "sit": "node sit/run.mjs",
    "sit:console": "PORT=8098 node sit/console.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "fastify": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "jose": "^6.0.10",
    "pg": "^8.16.0",
    "playwright": "1.55.1",
    "selenium-webdriver": "^4.48.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.2"
  },
  "license": "UNLICENSED"
}
