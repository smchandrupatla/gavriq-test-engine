{
  "name": "gavriq-test-engine",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/worker.ts",
    "start:scheduler": "tsx apps/api/src/scheduler.ts",
    "migrate": "tsx apps/api/src/db/migrate.ts",
    "seed": "tsx apps/api/src/seed.ts",
    "import:sit": "tsx apps/api/src/import-sit-catalog.ts",
    "mint-token": "tsx apps/api/src/scripts/mint-token.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/e2e-api-flow.test.ts",
    "test:unit": "tsx --test tests/enterprise-api-smoke.test.ts",
    "build:use-cases": "tsx scripts/build-use-cases.ts",
    "check:use-cases": "tsx scripts/build-use-cases.ts --check",
    "test:use-cases": "tsx --test tests/use-case-comprehensive.test.ts tests/use-cases.test.ts tests/use-case-structure.test.ts tests/use-case-pipeline.test.ts tests/use-case-markdown.test.ts tests/use-case-lookup.test.ts",
    "test:gui": "playwright test tests/gui",
    "build:schema-canvas": "esbuild apps/web/src/schema-canvas-flow.tsx --bundle --minify --format=iife --global-name=SbeSchemaCanvasFlow --jsx=automatic --outfile=apps/web/public/vendor/schema-canvas-flow.js",
    "build:schema-canvas-layout": "esbuild apps/web/src/schema-canvas-layout.ts --bundle --minify --format=iife --global-name=SbeSchemaCanvasLayout --outfile=apps/web/public/vendor/schema-canvas-layout.js",
    "build:agentdesk-rule-flow": "esbuild apps/agentdesk/src/rule-flow-canvas.tsx --bundle --minify --format=iife --global-name=SbeAgentDeskRuleFlow --jsx=automatic --outfile=apps/agentdesk/public/rule-flow-canvas.js",
    "test:cypress": "cypress run --e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:snyk": "npx --yes snyk test --severity-threshold=high --all-projects",
    "sit": "node sit/run.mjs",
    "sit:console": "PORT=8098 node sit/console.mjs",
    "test:sit": "tsx --test tests/sit-console.test.ts tests/sit-release.test.ts tests/delivery-capture.test.ts tests/testhub.test.ts",
    "test:engine-traceability": "tsx --test tests/test-engine-traceability.test.ts tests/sit-console.test.ts",
    "sit:use-cases": "node sit/run-use-cases.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "fastify": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "jose": "^6.0.10",
    "pg": "^8.16.0",
    "playwright": "1.55.1",
    "selenium-webdriver": "^4.48.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2"
  },
  "license": "UNLICENSED"
}
