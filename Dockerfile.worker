# Multi-runner worker: HTTP / performance / SIT case files, Selenium (Chrome)
# and Playwright (Chromium, Firefox, WebKit).
#
# Everything a catalogue case can ask for has to exist in this image — a case
# whose browser or script file is missing fails in milliseconds with a
# "script_problem" and looks like it "never ran". Keep these in step with the
# catalogue:
#   - sit/ + dev/ + docs/use-cases : the imported SIT case files and what they import
#   - chromium + chromium-driver   : one version-matched pair for every Selenium case
#   - Playwright firefox + webkit  : the cross-browser compatibility matrix
FROM node:22-bookworm-slim

WORKDIR /app

# Chrome + ChromeDriver from the same apt transaction, so they stay a matching
# pair (ChromeDriver refuses to drive a Chrome of a different major version).
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json* ./
RUN npm install

# Firefox and WebKit builds for the pinned Playwright version, plus their
# system libraries. Chromium cases keep using the apt Chrome above (CHROME_BIN).
# Must run through the repo's own playwright CLI: a bare `npx playwright`
# resolves a different version and installs browsers this one cannot launch.
RUN env -u PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD \
    node node_modules/playwright/cli.js install --with-deps firefox webkit \
    && rm -rf /var/lib/apt/lists/*

COPY apps ./apps
COPY sit ./sit
COPY dev ./dev
COPY docs/use-cases ./docs/use-cases
COPY data/iso20022-upload ./data/iso20022-upload
COPY tsconfig.json* ./

ENV NODE_ENV=production
# Targets written as 127.0.0.1/localhost are re-pointed at the host gateway
# (see apps/worker/src/worker.ts).
ENV WORKER_IN_CONTAINER=true

CMD ["npx", "tsx", "apps/worker/src/worker.ts"]
