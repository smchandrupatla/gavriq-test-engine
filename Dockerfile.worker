# Selenium/HTTP worker with headless Chrome + ChromeDriver
FROM node:22-bookworm-slim

WORKDIR /app

# Chrome + dependencies for headless Selenium
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# SIT cases drive the same system Chromium.
ENV SIT_CHROME_BINARY=/usr/bin/chromium
ENV SIT_CHROMEDRIVER_PATH=/usr/bin/chromedriver

COPY package.json package-lock.json* ./
RUN npm install

COPY apps ./apps
# The SIT runner executes sit/cases/*.sit.ts; without these the worker reported
# "SIT file not found" for every imported SIT case.
COPY sit ./sit
COPY tests/helpers ./tests/helpers
COPY tests/fixtures ./tests/fixtures
COPY tsconfig.json* ./

ENV NODE_ENV=production

CMD ["npx", "tsx", "apps/worker/src/worker.ts"]
