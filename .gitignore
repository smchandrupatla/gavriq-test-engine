*-result.json
*-results.json
test-results/
playwright-report/

.docker-results/
# Infra agent pid file (scripts/start-infra-agent.ps1); its logs are covered by *.log
infra-agent.pid
# Record agent pid file (scripts/start-record-agent.ps1); its logs are covered by *.log
record-agent.pid

# Scratch written by the author-time harness (dev/scripts/run-catalog-local.ts)
.tmp/harness-evidence/
.tmp/lane*/
.tmp/*.json
