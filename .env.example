# Local evaluation only. Replace placeholders before starting.

# --- SIT console / runner targets ---
# SIT_CONSOLE_SIT_API_BASE / SIT_SIT_API_BASE: leave unset to use the co-located Test
# Engine instance (they now ship in one container — see compose.yaml's test-engine
# service). Only set these to point the SIT console/one-shot job at a different,
# externally deployed target.
# SIT_CONSOLE_SIT_API_BASE=http://host.docker.internal:8787
# SIT_SIT_API_BASE=http://host.docker.internal:8787
SIT_CONSOLE_SIT_DBVIEWER_BASE=http://host.docker.internal:8090
SIT_CONSOLE_SIT_TESTHUB_BASE=http://host.docker.internal:8091
SIT_CONSOLE_SIT_WEB_BASE=http://host.docker.internal:80
SIT_SIT_DBVIEWER_BASE=http://host.docker.internal:8090
SIT_SIT_TESTHUB_BASE=http://host.docker.internal:8091
SIT_SIT_WEB_BASE=http://host.docker.internal:80

# --- Test Engine control plane ---
# DATABASE_URL=postgres://sitconsole:sitconsole@127.0.0.1:5432/sitconsole
# PORT=8787
# RBAC_ENABLED=false
# AUTO_SEED=true
# WORKER_API_KEY=
# TEST_ENGINE_HOST_PORT=8787
# Start the worker with every `docker compose up` (an always-on machine); otherwise pass --profile workers.
# COMPOSE_PROFILES=workers
# Evidence gate: enforce | report | off; evidence retention in days (0 = keep); cron time zone; trigger API keys.
# EVIDENCE_GATE=enforce
# EVIDENCE_RETENTION_DAYS=30
# SCHEDULER_TZ=Australia/Sydney
# TRIGGER_API_KEYS=sand-bench-deployer:<random 32+ chars>
# Deploy-to-env (POST /api/v1/deployments): base URL this engine is reachable at, used to build the
# callback_url an environment's own deploy API POSTs the result to; and the key that callback must
# present as X-Api-Key (add it to TRIGGER_API_KEYS above too, e.g. "sandbench-deploy:<random 32+ chars>").
# The key itself is named per-environment via that environment's config.deploy_api.key_env.
# ENGINE_PUBLIC_URL=http://127.0.0.1:8797
# SANDBENCH_DEPLOY_KEY=
# Quality Insights: the key lets "Refresh insights" be written by Claude (built-in rules without it).
# ANTHROPIC_API_KEY=
# INSIGHTS_MODEL=claude-opus-5
# INSIGHTS_EFFORT=high

# --- Worker ---
# TEST_ENGINE_API=http://127.0.0.1:8787
TARGET_BASE_URL=http://host.docker.internal:8001
# WORKER_POLL_MS=4000
